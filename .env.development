# =============================================================================
# Medico no Bolso - Frontend Development Environment
# =============================================================================
# Este arquivo contem configuracoes para ambiente de DESENVOLVIMENTO LOCAL.
# NAO use em producao!
#
# SETUP:
#   1. Copie este arquivo para .env.local
#   2. Certifique-se que o backend esta rodando em localhost:8080
#   3. npm run dev
#
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Firebase Configuration
# Use as mesmas credenciais do projeto Firebase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB3VIRZ-rCbRVC4eybhJNG-dMdw1LVMF9I
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=projeto-med-19a8b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=projeto-med-19a8b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=projeto-med-19a8b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Doctor-Server API Configuration (Backend LOCAL)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_USE_NEW_API=true
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_MAX_RETRIES=3
NEXT_PUBLIC_API_RETRY_DELAY=1000
NEXT_PUBLIC_API_CACHE_ENABLED=true
NEXT_PUBLIC_API_CACHE_TTL=300000

# -----------------------------------------------------------------------------
# App URL (frontend local)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# JWT Secret (deve ser igual ao do backend para validacao de tokens)
# -----------------------------------------------------------------------------
JWT_SECRET=dev-secret-key-do-not-use-in-production-12345678901234567890abcdefghij

# -----------------------------------------------------------------------------
# TISS Service URL (mesmo que API URL em dev)
# -----------------------------------------------------------------------------
TISS_SERVICE_URL=http://localhost:8080/api/v1

# -----------------------------------------------------------------------------
# Stripe Configuration (opcional para desenvolvimento)
# Obtenha suas chaves em: https://dashboard.stripe.com/test/apikeys
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# -----------------------------------------------------------------------------
# Feature Flags para Desenvolvimento
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=true
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
